# Build output
/bin/
/dist/
# Go
/vendor/
# Editor / OS
.DS_Store
.idea/
.vscode/
# Local scratch
/tmp/

# tool-local
.claude/settings.local.json
.claude/worktrees/
/ktags

# Personal material stays on this laptop. Only shared Markdown contracts are published.
*.[mM][dD]
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/.github/PULL_REQUEST_TEMPLATE.md
!/.agents/skills/*/SKILL.md
!/.claude/agents/*.md
!/docs/workflow.md
!/docs/guides/*.md
!/docs/adr/*.md
/docs/STATUS.md
/docs/plan/
/docs/research/
/docs/design/
/docs/test-reports/

# Scratch scripts and personal documents belong in these directories.
/local/
/scratch/
/notes/
/private/
/chats/
/conversations/
/transcripts/
/scripts/local/
/scripts/tmp/
*.local.*
*.tmp
*.bak
*.log
*.jsonl
*.cast
__pycache__/
*.py[cod]

# Tool state, credentials and conversation history; shared configs remain versioned.
.serena/
.codex/sessions/
.codex/archived_sessions/
.codex/log/
.codex/tmp/
.codex/worktrees/
.codex/auth.json
.codex/history*
.codex/*.sqlite*
.claude/projects/
.claude/history*
.claude/transcripts/
.claude/session-env/
.claude/todos/
.claude/debug/
.claude/plans/
.claude/tasks/
.claude/teams/
.agents/memory/
.agents/memories/
.aider*
.opencode/

# Secret material, including encrypted customer data, is never a repository asset.
.env*
*.key
*.age
*.pem
*.p12
*.pfx
*.keystore
/secrets/
/credentials/
.ssh/
.aws/
.kube/
kubeconfig*
*.kubeconfig
rke2.yaml
id_rsa*
id_ed25519*
credentials.json
credentials.yaml
service-account*.json
api-keys*
tokens.json

# Compiled spike executables are local outputs.
/spikes/*/ktags-spike-*
