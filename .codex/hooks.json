{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hook.py\" start", "timeout": 20}]}],
    "PreToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hook.py\" pre-tool", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hook.py\" stop", "timeout": 300}]}]
  }
}
