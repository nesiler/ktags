#!/usr/bin/env sh
# Quick local gate before push: formatting, vet, short tests, attribution scan of pushed commits.
# The full gate (lint, -race) runs in CI. Skip with --no-verify only for docs-only pushes.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch. Base on origin/main when it exists; on an empty remote scan the whole history.
    if git rev-parse --verify -q origin/main >/dev/null; then
      base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
      [ -n "$base" ] || { echo "pre-push: no base against origin/main; run git fetch origin" >&2; exit 1; }
      range="$base..$local_sha"
    else
      range="$local_sha"
    fi
  else
    [ "$remote_sha" = "$local_sha" ] && continue
    range="$remote_sha..$local_sha"
  fi
  scripts/guard.sh verify-attribution "$range"
done

if [ -f go.mod ]; then
  unformatted="$(gofmt -l $(git ls-files '*.go' | grep -v '^spikes/') 2>/dev/null || true)"
  if [ -n "$unformatted" ]; then
    echo "pre-push: gofmt needed:" >&2; echo "$unformatted" | sed 's/^/  /' >&2; exit 1
  fi
  go vet ./...
  go test -short ./...
fi
